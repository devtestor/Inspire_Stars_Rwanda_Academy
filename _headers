# Netlify / Cloudflare Pages header rules.
# Other hosts ignore this file harmlessly — see .htaccess for Apache
# and netlify.toml for Netlify's own equivalent.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# The HTML must never be cached hard, or edits won't show up for visitors.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Images and video never change without also changing their filename,
# so they can be cached for a year.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon-96x96.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
